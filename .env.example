DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
EXPIRY_WARNING_DAYS=30
# gemini (the project default) | disabled | openai | ollama
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
# Select an available text model with JSON output in Google AI Studio.
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=24000
# Ollama: AI_PROVIDER=ollama, AI_BASE_URL=http://127.0.0.1:11434
# Set a model already installed in Ollama.
# PostgreSQL (optional: pip install psycopg[binary])
DB_ENGINE=sqlite
DB_NAME=apartment_rental
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
